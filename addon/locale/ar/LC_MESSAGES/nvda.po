msgid "Turns Chat Translator on or off everywhere"
msgstr "تشغيل مترجم المحادثات أو إيقافه في كل مكان"

msgid "Chat Translator on"
msgstr "مترجم المحادثات يعمل"

msgid "Chat Translator off"
msgstr "مترجم المحادثات متوقف"

