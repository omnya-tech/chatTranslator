msgstr "المعنى: %s"

msgid "Sent"
msgstr "أُرسلت"

msgid "Received"
msgstr "واردة"

msgid "Sent without translation"
msgstr "أُرسلت دون ترجمة"

msgid "Sends the message as written, without translating it"
msgstr "إرسال الرسالة كما كُتبت دون ترجمتها"

msgid "Not in a message field"
msgstr "لست في خانة كتابة"

msgid "Detect the other party's language automatically from their messages"
msgstr "التعرّف على لغة الطرف الآخر تلقائيًا من رسائله"

msgid "The other party's language is now %s"
msgstr "لغة الطرف الآخر الآن هي %s"

msgid "Let me hear the translation before sending; Enter again sends it"
msgstr "نطق الترجمة قبل الإرسال، على أن تُرسَل بالضغط على Enter مرة أخرى"

msgid "Translate my message back into my language so I can check its meaning"
msgstr "ترجمة رسالتي عكسيًا إلى لغتي للتأكد من معناها"

msgid "Words that must not be translated, such as company and product names (one per line):"
msgstr "كلمات لا تُترجَم، مثل أسماء الشركات والمنتجات (كلمة في كل سطر):"

msgid "Keep a history of translated messages"
msgstr "الاحتفاظ بسجل للرسائل المترجَمة"

msgid "Clear history"
msgstr "مسح السجل"

msgid "Delete all translated messages from the history?"
msgstr "هل تريد حذف جميع الرسائل المترجَمة من السجل؟"

msgid "The history has been cleared"
msgstr "مُسح السجل"

msgid "Shows the history of translated messages"
msgstr "عرض سجل الرسائل المترجَمة"

msgid "The history is empty"
msgstr "السجل فارغ"

msgid "Translation history"
msgstr "سجل الترجمة"

msgid "Original: %s"
msgstr "الأصل: %s"

msgid "Translation: %s"
msgstr "الترجمة: %s"

msgid "Close"
msgstr "إغلاق"

msgid "Translates the selected text, or the clipboard when nothing is selected; press twice to copy the translation"
msgstr "ترجمة النص المحدد، أو محتوى الحافظة إن لم يُحدَّد نص، والضغط مرتين ينسخ الترجمة"

msgid "No text is selected and the clipboard is empty"
msgstr "لا يوجد نص محدد، والحافظة فارغة"

msgid "Translation copied"
msgstr "نُسخت الترجمة"

msgid "Translation failed. %s"
msgstr "تعذّرت الترجمة. %s"

msgid "Developed by %s"
msgstr "تطوير: %s"

msgid "DeepL (excellent, requires a free API key)"
msgstr "DeepL (ممتازة، وتتطلّب مفتاح API مجانيًّا)"

msgid "DeepL API key:"
msgstr "مفتاح DeepL API:"

msgid "No DeepL API key has been entered; enter it in the add-on settings"
msgstr "لم يُدخَل مفتاح DeepL API، أدخِله من إعدادات الإضافة"

msgid "The DeepL API key is not valid"
msgstr "مفتاح DeepL API غير صالح"

msgid "The DeepL monthly character limit has been used up"
msgstr "استُنفد الحدّ الشهري من الأحرف في خدمة DeepL"

msgid "NVDA's language (%s)"
msgstr "لغة NVDA (%s)"

msgid "The API key could not be saved"
msgstr "تعذّر حفظ مفتاح API"

msgid "Pastes the clipboard into the message field, translated into the other party's language"
msgstr "لصق محتوى الحافظة في خانة الكتابة مترجمًا إلى لغة الطرف الآخر"

msgid "The clipboard is empty"
msgstr "الحافظة فارغة"

msgid "Pasting was cancelled because you left the message field"
msgstr "أُلغي اللصق لأنك غادرت خانة الكتابة"

msgid "Could not read the message field"
msgstr "تعذّرت قراءة خانة الكتابة"

msgid "The message is too long for %s"
msgstr "الرسالة أطول مما تقبله خدمة %s"

