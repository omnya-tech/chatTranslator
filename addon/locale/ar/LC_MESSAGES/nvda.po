msgid "Chat Translator"
msgstr "مترجم المحادثات"

msgid "The message was not sent. %s"
msgstr "لم تُرسَل الرسالة. %s"

msgid "Sending was cancelled because you left the message field; your message is unchanged"
msgstr "أُلغي الإرسال لأنك غادرت خانة الكتابة، وبقيت رسالتك كما هي"

msgid "Could not put the translation in the message field, so the message was not sent"
msgstr "تعذّر وضع الترجمة في خانة الكتابة، فلم تُرسَل الرسالة"

msgid "Sent in %s"
msgstr "أُرسلت باللغة %s"

msgid "Turns translation on or off in the current conversation; pressed twice, in every conversation of the program"
msgstr "تفعيل الترجمة في المحادثة الحالية أو إيقافها، والضغط مرتين يطبّق ذلك على كل محادثات البرنامج"

msgid "Translation on in all conversations of %s"
msgstr "تفعّلت الترجمة في كل محادثات %s"

msgid "Translation off in all conversations of %s"
msgstr "توقفت الترجمة في كل محادثات %s"

msgid "All conversations of %s"
msgstr "كل محادثات %s"

msgid "Translation on, the other party's language is %s"
msgstr "تفعّلت الترجمة، ولغة الطرف الآخر هي %s"

msgid "Translation off"
msgstr "توقفت الترجمة"

msgid "Chooses the other party's language in the current conversation"
msgstr "اختيار لغة الطرف الآخر في المحادثة الحالية"

msgid "What language does the other party use?"
msgstr "ما لغة الطرف الآخر؟"

msgid "Your messages will be sent in %s"
msgstr "ستُرسَل رسائلك باللغة %s"

msgid "Speaks the original text of the last translation"
msgstr "نطق النص الأصلي لآخر ما تُرجِم"

msgid "Nothing has been translated yet"
msgstr "لم يُترجَم شيء بعد"

msgid "Reports the translation status of the current conversation"
msgstr "معرفة حالة الترجمة في المحادثة الحالية"

msgid "Translation on, the other party's language is %(language)s, the translation service is %(service)s"
msgstr "الترجمة مفعّلة، ولغة الطرف الآخر هي %(language)s، وخدمة الترجمة هي %(service)s"

msgid "Translation is off in this conversation"
msgstr "الترجمة متوقفة في هذه المحادثة"

msgid "Translation service:"
msgstr "خدمة الترجمة:"

msgid "Claude API key:"
msgstr "مفتاح Claude API:"

msgid "Claude model:"
msgstr "نموذج Claude:"

msgid "Write my messages in a formal tone suitable for businesses"
msgstr "صياغة رسائلي بأسلوب رسمي يناسب مراسلة الشركات"

msgid "Automatically use another free service if the chosen one fails"
msgstr "استخدام خدمة مجانية بديلة تلقائيًا إذا تعذّرت الخدمة المختارة"

msgid "My language (incoming messages are translated into it):"
msgstr "لغتي (تُترجَم إليها الرسائل الواردة):"

msgid "Default language of the other party:"
msgstr "لغة الطرف الآخر الافتراضية:"

msgid "Translate my messages before sending them when I press Enter"
msgstr "ترجمة رسائلي قبل إرسالها عند الضغط على Enter"

msgid "Translate incoming messages when reading them"
msgstr "ترجمة الرسائل الواردة عند قراءتها"

msgid "Google Translate (free)"
msgstr "ترجمة جوجل (مجانية)"

msgid "Microsoft Bing Translator (free)"
msgstr "مترجم مايكروسوفت Bing (مجاني)"

msgid "MyMemory (free, with a daily limit)"
msgstr "MyMemory (مجانية، بحدّ يومي)"

msgid "Claude (most accurate, requires an API key)"
msgstr "Claude (أدقّ، ويتطلّب مفتاح API)"

msgid "Google"
msgstr "جوجل"

msgid "Microsoft Bing"
msgstr "مايكروسوفت Bing"

msgid "%(service)s returned error %(code)d"
msgstr "أعادت خدمة %(service)s الخطأ %(code)d"

msgid "Could not understand the response from %s"
msgstr "لم يُفهَم ردّ خدمة %s"

msgid "%s returned an empty translation"
msgstr "أعادت خدمة %s ترجمة فارغة"

msgid "The Microsoft Bing page has changed and can no longer be used"
msgstr "تغيّرت صفحة مايكروسوفت Bing ولم يعد ممكنًا استخدامها"

msgid "The free daily limit of MyMemory has been used up"
msgstr "استُنفد الحدّ اليومي المجاني لخدمة MyMemory"

msgid "%(service)s returned an error: %(error)s"
msgstr "أعادت خدمة %(service)s خطأ: %(error)s"

msgid "No Claude API key has been entered; enter it in the add-on settings"
msgstr "لم يُدخَل مفتاح Claude API، أدخِله من إعدادات الإضافة"

